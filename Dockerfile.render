FROM node:22-alpine AS build

WORKDIR /app

# Prisma generate validates its datasource during the image build but does not
# connect to it. Runtime migrations use Render's DATABASE_URL instead.
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build?schema=public
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

COPY package.json package-lock.json ./
COPY server/package.json server/package.json
RUN npm ci

COPY . .
RUN npm run db:generate && npm run build:web && npm run build:api

FROM node:22-alpine AS runtime

RUN apk add --no-cache nginx gettext

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY server/package.json server/package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/server/dist ./server/dist
COPY --from=build /app/server/prisma ./server/prisma
COPY deploy/nginx.render.conf.template /app/deploy/nginx.render.conf.template
COPY deploy/start-render.sh /app/deploy/start-render.sh

RUN rm -f /etc/nginx/http.d/default.conf \
    && sed -i 's/\r$//' /app/deploy/start-render.sh \
    && chmod +x /app/deploy/start-render.sh \
    && sh -n /app/deploy/start-render.sh \
    && RENDER_PUBLIC_PORT=10000 envsubst '${RENDER_PUBLIC_PORT}' \
      < /app/deploy/nginx.render.conf.template \
      > /etc/nginx/http.d/default.conf \
    && nginx -t \
    && rm -f /etc/nginx/http.d/default.conf

EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT:-10000}/healthz" || exit 1

CMD ["/app/deploy/start-render.sh"]
